# Full domain for your Nextcloud instance (DNS and port forwarding must already be set up)
DOMAIN=nextcloud.example.com

# Email address for Let's Encrypt expiry notifications (optional).
# Leave empty to register without email. A made-up address is also accepted
# by Let's Encrypt — the value is never verified, only used for notifications.
EMAIL=

# Absolute path for persistent data storage.
# Leave empty to use ./nextcloud-data (automatically git-ignored).
# If set, Nextcloud must be initialised manually from the browser on first deploy.
DATA_PATH=

# Linux user ID that will own the Nextcloud html/data files (check with: id -u)
USER_ID=1000
